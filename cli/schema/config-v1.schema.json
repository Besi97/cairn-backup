{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/Besi97/cairn-backup/main/cli/schema/config-v1.schema.json",
  "title": "Cairn configuration, version 1",
  "description": "Named repositories and workflows. Validate offline with cairn config check. See docs/configuration.md.",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "repositories", "workflows"],
  "properties": {
    "version": {
      "type": "integer",
      "const": 1,
      "description": "Required configuration schema version; never inferred."
    },
    "metrics": {
      "type": "object",
      "additionalProperties": false,
      "required": ["listen"],
      "properties": {
        "listen": { "$ref": "#/$defs/nonemptyString", "description": "Explicit IP address and port for the optional agent Prometheus endpoint." }
      }
    },
    "repositories": {
      "type": "object",
      "description": "Named existing Borg repositories. An empty map is allowed.",
      "propertyNames": { "minLength": 1 },
      "additionalProperties": { "$ref": "#/$defs/repository" }
    },
    "workflows": {
      "type": "object",
      "description": "Named procedures, optionally scheduled. An empty map is allowed.",
      "propertyNames": { "minLength": 1 },
      "additionalProperties": { "$ref": "#/$defs/workflow" }
    }
  },
  "$defs": {
    "nonemptyString": {
      "type": "string",
      "minLength": 1
    },
    "lockWait": {
      "type": "integer",
      "minimum": 0,
      "default": 60,
      "description": "Borg lock-acquisition timeout in seconds, not a task timeout. Zero does not wait."
    },
    "repository": {
      "type": "object",
      "additionalProperties": false,
      "required": ["location"],
      "properties": {
        "location": {
          "$ref": "#/$defs/nonemptyString",
          "description": "Existing local repository or native Borg SSH location, never an archive. Local relative paths use the config directory; ~ and ~/ expand locally."
        },
        "passphrase": {
          "type": "string",
          "description": "Literal secret, including an explicitly empty passphrase. Mutually exclusive with passphrase_file. Never expand or log this value."
        },
        "passphrase_file": {
          "$ref": "#/$defs/nonemptyString",
          "description": "Passphrase file, relative to the config directory; ~ and ~/ expand. Mutually exclusive with passphrase."
        },
        "identity_file": {
          "$ref": "#/$defs/nonemptyString",
          "description": "SSH identity file, relative to the config directory; ~ and ~/ expand. Only valid for SSH repositories."
        }
      },
      "not": { "required": ["passphrase", "passphrase_file"] }
    },
    "workflow": {
      "type": "object",
      "additionalProperties": false,
      "required": ["stages"],
      "properties": {
        "cron": {
          "$ref": "#/$defs/nonemptyString",
          "description": "Five-field cron (minute hour day-of-month month day-of-week), or @hourly, @daily/@midnight, @weekly, @monthly, @yearly/@annually. Omit for manual-only execution. Syntax/ranges are checked by cairn config check."
        },
        "timezone": {
          "$ref": "#/$defs/nonemptyString",
          "description": "IANA timezone name or UTC for cron; defaults to the agent process local timezone. Does not change archive timestamps or Borg retention. Validated by cairn config check, including on manual-only workflows."
        },
        "stages": {
          "type": "array",
          "minItems": 1,
          "description": "Run in order; advance only if all tasks in the previous stage succeeded without warnings.",
          "items": { "$ref": "#/$defs/stage" }
        }
      }
    },
    "stage": {
      "type": "object",
      "additionalProperties": false,
      "required": ["tasks"],
      "properties": {
        "tasks": {
          "type": "array",
          "minItems": 1,
          "description": "Run concurrently. Let siblings finish after a warning or failure, then stop the workflow.",
          "items": { "$ref": "#/$defs/task" }
        }
      }
    },
    "task": {
      "oneOf": [
        { "$ref": "#/$defs/backupTask" },
        { "$ref": "#/$defs/pruneTask" },
        { "$ref": "#/$defs/compactTask" },
        { "$ref": "#/$defs/checkTask" },
        { "$ref": "#/$defs/recoveryCheckTask" },
        { "$ref": "#/$defs/commandTask" }
      ]
    },
    "commandTask": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "program", "args", "timeout_seconds"],
      "properties": {
        "type": { "const": "command" },
        "program": { "$ref": "#/$defs/nonemptyString", "description": "Executable name or path." },
        "args": { "type": "array", "items": { "type": "string" }, "description": "Literal arguments, without shell interpretation." },
        "timeout_seconds": { "type": "integer", "minimum": 1, "maximum": 9223372036 }
      }
    },
    "recoveryCheckTask": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "repository"],
      "properties": {
        "type": { "const": "recovery_check" },
        "repository": { "$ref": "#/$defs/nonemptyString" },
        "archive_name": { "$ref": "#/$defs/nonemptyString" },
        "archive_prefix": { "$ref": "#/$defs/nonemptyString" },
        "paths": { "type": "array", "minItems": 1, "maxItems": 1000, "items": { "$ref": "#/$defs/nonemptyString", "maxLength": 4096 } },
        "whole_archive": { "const": true },
        "lock_wait": { "$ref": "#/$defs/lockWait" },
        "checks": { "type": "array", "minItems": 1, "maxItems": 1000, "items": { "$ref": "#/$defs/recoveryAssertion" } },
        "sample": {
          "type": "object", "additionalProperties": false, "required": ["live_root", "limit"],
          "properties": { "live_root": { "$ref": "#/$defs/nonemptyString" }, "limit": { "type": "integer", "minimum": 1, "maximum": 10000 } }
        }
      },
      "allOf": [
        { "oneOf": [{ "required": ["archive_name"] }, { "required": ["archive_prefix"] }] },
        { "oneOf": [{ "required": ["paths"] }, { "required": ["whole_archive"] }] },
        { "anyOf": [{ "required": ["checks"] }, { "required": ["sample"] }] }
      ]
    },
    "recoveryAssertion": {
      "type": "object",
      "required": ["kind", "path"],
      "properties": {
        "kind": { "enum": ["path_type", "file_size", "file_bytes", "file_count", "file_sha256"] },
        "path": { "$ref": "#/$defs/nonemptyString", "maxLength": 4096 },
        "type": { "enum": ["file", "directory", "symlink", "fifo", "socket", "block_device", "char_device"] },
        "size": { "type": "integer", "minimum": 0 },
        "bytes": { "type": "string" },
        "count": { "type": "integer", "minimum": 0 },
        "sha256": { "type": "string", "minLength": 64, "maxLength": 64, "pattern": "^[0-9a-fA-F]{64}$" }
      },
      "oneOf": [
        { "properties": { "kind": { "const": "path_type" } }, "required": ["type"], "not": { "anyOf": [{"required":["size"]},{"required":["bytes"]},{"required":["count"]},{"required":["sha256"]}] } },
        { "properties": { "kind": { "const": "file_size" } }, "required": ["size"], "not": { "anyOf": [{"required":["type"]},{"required":["bytes"]},{"required":["count"]},{"required":["sha256"]}] } },
        { "properties": { "kind": { "const": "file_bytes" } }, "required": ["bytes"], "not": { "anyOf": [{"required":["type"]},{"required":["size"]},{"required":["count"]},{"required":["sha256"]}] } },
        { "properties": { "kind": { "const": "file_count" } }, "required": ["count"], "not": { "anyOf": [{"required":["type"]},{"required":["size"]},{"required":["bytes"]},{"required":["sha256"]}] } },
        { "properties": { "kind": { "const": "file_sha256" } }, "required": ["sha256"], "not": { "anyOf": [{"required":["type"]},{"required":["size"]},{"required":["bytes"]},{"required":["count"]}] } }
      ],
      "additionalProperties": false
    },
    "backupTask": {
      "title": "Backup task",
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "repository", "sources"],
      "properties": {
        "type": { "const": "backup" },
        "repository": {
          "$ref": "#/$defs/nonemptyString",
          "description": "Name of a repository defined in repositories, not its location."
        },
        "archive_prefix": {
          "$ref": "#/$defs/nonemptyString",
          "description": "Append Cairn's UTC timestamp. Borg placeholders remain unchanged. Mutually exclusive with archive_name."
        },
        "archive_name": {
          "$ref": "#/$defs/nonemptyString",
          "description": "Exact archive name, with native Borg placeholders; no timestamp is added. Mutually exclusive with archive_prefix."
        },
        "source_root": {
          "$ref": "#/$defs/nonemptyString",
          "description": "Borg working directory. Defaults to the config directory. Relative paths use that directory; ~ and ~/ expand."
        },
        "sources": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/nonemptyString" },
          "description": "Native Borg source arguments, unchanged. Relative paths use source_root, not Cairn's invocation directory."
        },
        "exclude": {
          "type": "array",
          "items": { "type": "string" },
          "description": "Native Borg exclusion patterns, unchanged."
        },
        "lock_wait": { "$ref": "#/$defs/lockWait" }
      },
      "oneOf": [
        { "required": ["archive_prefix"] },
        { "required": ["archive_name"] }
      ]
    },
    "pruneTask": {
      "title": "Prune task",
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "repository", "archive_prefix"],
      "properties": {
        "type": { "const": "prune" },
        "repository": {
          "$ref": "#/$defs/nonemptyString",
          "description": "Name of a repository defined in repositories, not its location."
        },
        "archive_prefix": {
          "$ref": "#/$defs/nonemptyString",
          "description": "Select PREFIX-* using native Borg placeholders and glob semantics. Matching exact-name archives are also in scope."
        },
        "keep_within": {
          "type": "string",
          "pattern": "^\\+?0*[1-9][0-9]*[Hdwmy]$",
          "not": { "pattern": "[\\r\\n]" },
          "description": "Positive integer followed by H, d, w, m, or y, using Borg interval semantics."
        },
        "keep_secondly": {
          "type": "integer",
          "description": "Borg retention count: zero disables, negative means unlimited periods."
        },
        "keep_minutely": {
          "type": "integer",
          "description": "Borg retention count: zero disables, negative means unlimited periods."
        },
        "keep_hourly": {
          "type": "integer",
          "description": "Borg retention count: zero disables, negative means unlimited periods."
        },
        "keep_daily": {
          "type": "integer",
          "description": "Borg retention count: zero disables, negative means unlimited periods."
        },
        "keep_weekly": {
          "type": "integer",
          "description": "Borg retention count: zero disables, negative means unlimited periods."
        },
        "keep_monthly": {
          "type": "integer",
          "description": "Borg retention count: zero disables, negative means unlimited periods."
        },
        "keep_yearly": {
          "type": "integer",
          "description": "Borg retention count: zero disables, negative means unlimited periods."
        },
        "lock_wait": { "$ref": "#/$defs/lockWait" }
      },
      "anyOf": [
        { "required": ["keep_within"] },
        { "required": ["keep_secondly"], "properties": { "keep_secondly": { "not": { "const": 0 } } } },
        { "required": ["keep_minutely"], "properties": { "keep_minutely": { "not": { "const": 0 } } } },
        { "required": ["keep_hourly"], "properties": { "keep_hourly": { "not": { "const": 0 } } } },
        { "required": ["keep_daily"], "properties": { "keep_daily": { "not": { "const": 0 } } } },
        { "required": ["keep_weekly"], "properties": { "keep_weekly": { "not": { "const": 0 } } } },
        { "required": ["keep_monthly"], "properties": { "keep_monthly": { "not": { "const": 0 } } } },
        { "required": ["keep_yearly"], "properties": { "keep_yearly": { "not": { "const": 0 } } } }
      ]
    },
    "checkTask": {
      "title": "Check task",
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "repository"],
      "properties": {
        "type": { "const": "check" },
        "repository": {
          "$ref": "#/$defs/nonemptyString",
          "description": "Name of a repository defined in repositories. Check whole-repository consistency and all archive metadata without repair."
        },
        "verify_data": {
          "type": "boolean",
          "default": false,
          "description": "Also cryptographically verify archived file contents. Reads all data and can be slow or transfer substantial data over SSH."
        },
        "lock_wait": { "$ref": "#/$defs/lockWait" }
      }
    },
    "compactTask": {
      "title": "Compact task",
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "repository"],
      "properties": {
        "type": { "const": "compact" },
        "repository": {
          "$ref": "#/$defs/nonemptyString",
          "description": "Name of a repository defined in repositories. Compaction is repository-wide and needs no encryption key or passphrase."
        },
        "lock_wait": { "$ref": "#/$defs/lockWait" }
      }
    }
  }
}
